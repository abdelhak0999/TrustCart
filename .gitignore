# Python environment
.venv/
.venv-app/

# Python & Jupyter cache
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/

# Credentials (never commit)
kaggle.json
access_token
.env

# Data and Kaggle run outputs (large files regenerated by notebooks)
/data/
/outputs/

# Large model formats
*.npz
*.h5
*.pt
*.pkl

# Models directory: ignore future models by default, but KEEP the app artifacts
models/*
!models/rnn/
!models/cnn/
!models/decision/

# Explicitly whitelist the artifacts needed by Streamlit & the decision model
!models/rnn/*.keras
!models/rnn/*.parquet
!models/rnn/*.csv
!models/cnn/*.keras
!models/cnn/*.json
!models/cnn/sample_crops/
!models/cnn/sample_crops/*.jpg
!models/cnn/sample_crops/*.json
!models/decision/*.json
!models/decision/*.parquet
