# Python environment
.venv/
.venv-app/

# Python & Jupyter cache
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/

# Credentials (never commit)
kaggle.json
access_token
.env

# Data and Kaggle run outputs (large files regenerated by notebooks)
/data/
/outputs/

# Large model formats
*.npz
*.h5
*.pt
*.pkl

# Models directory: ignore future models by default, but KEEP models/rnn/ for the app
models/*
!models/rnn/

# Explicitly whitelist the RNN artifacts needed by Streamlit & Logistic Regression
!models/rnn/*.keras
!models/rnn/*.parquet
!models/rnn/*.csv
