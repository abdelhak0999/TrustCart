# Copy this file to .env and fill it in. Never commit .env.

# Which brain writes the staff messages: gemini, ollama or templates.
# Leave empty: Gemini if GEMINI_API_KEY is set, templates otherwise.
AGENT_BACKEND=

# How much narration the LLM does:
#   hybrid    = deterministic reports + LLM for the staff briefing and routed Q&A (recommended)
#   full_llm  = each model agent also narrates its own report
#   templates = no LLM at all (offline demo)
AGENT_MODE=hybrid

# Free key from https://aistudio.google.com  (Get API key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional per-agent overrides: GEMINI_MODEL_RNN, GEMINI_MODEL_CNN, GEMINI_MODEL_DECISION,
# GEMINI_MODEL_COORDINATOR. They default to GEMINI_MODEL.

# Optional: Ollama on this or another PC (start it with OLLAMA_HOST=0.0.0.0 to reach it from the network)
OLLAMA_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b
# Optional per-agent overrides: OLLAMA_MODEL_RNN, OLLAMA_MODEL_CNN, OLLAMA_MODEL_DECISION,
# OLLAMA_MODEL_COORDINATOR.
